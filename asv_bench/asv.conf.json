{
    "version": 1,
    "project": "pandas",
    "project_url": "https://pandas.pydata.org/",
    "repo": "..",
    "branches": ["main"],
    "environment_type": "rattler",
    "show_commit_url": "https://github.com/pandas-dev/pandas/commit/",
    "matrix": {
        "pip+build": [],
        "versioneer[toml]": [],
        // TEMPORARY (GH-66152), revert with the benchmark: unpinned resolves to
        // Cython 3.2.9, whose shared-utility mode builds a pandas that fails to
        // import ("_cyutility does not export expected C function
        // slice_memviewslice"), so `asv continuous` dies before running anything.
        "Cython": ["3.2.4"],
        "matplotlib": [],
        "sqlalchemy": [],
        "scipy": [],
        "numba": [],
        "numexpr": [],
        "pytables": [null, ""],
        "tables": [null, ""],
        "pyarrow": [],
        "openpyxl": [],
        "xlsxwriter": [],
        "odfpy": [],
        "jinja2": [],
        "meson": [],
        "meson-python": [],
        "python-build": []
    },
    "exclude": [
        {"environment_type": "conda|rattler", "tables": ""},
        {"environment_type": "conda|rattler", "pytables": null},
        {"environment_type": "(?!(?:conda|rattler)).*", "tables": null},
        {"environment_type": "(?!(?:conda|rattler)).*", "pytables": ""}
    ],
    "conda_channels": ["conda-forge"],
    "build_cache_size": 8,
    "regressions_first_commits": {
        ".*": "0409521665"
    },
    "build_command":
    ["python -m build -Cbuilddir=builddir --no-isolation --wheel --outdir {build_cache_dir} {build_dir}"]
}
